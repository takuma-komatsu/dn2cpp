<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The source generator shipped in the real package emits the client proxy and
         MessagePack resolver that this gate transpiles. -->
    <PackageReference Include="MagicOnion.Client" Version="7.10.2" />
  </ItemGroup>

</Project>
