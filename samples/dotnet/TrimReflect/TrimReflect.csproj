<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <!-- Deliberately no InvariantGlobalization: it is a runtimeconfig knob only real .NET
         reads, so it pins the ORACLE and not the transpiled subject, and it drops ICU, so
         a later section naming a real culture would assert nothing. The driver's culture
         pin is the one mechanism both sides honour, and
         gates/verify-culture-invariance.sh fails a bucket that reintroduces this. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TrimReflectLib/TrimReflectLib.csproj" />
  </ItemGroup>

</Project>
