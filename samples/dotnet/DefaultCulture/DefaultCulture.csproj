<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DefaultCulture</AssemblyName>
    <RootNamespace>DefaultCulture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Locale rejection must not recursively initialize CurrentUICulture to format its exception. -->
    <RuntimeHostConfigurationOption Include="System.Resources.UseSystemResourceKeys" Value="true" />
  </ItemGroup>

</Project>
