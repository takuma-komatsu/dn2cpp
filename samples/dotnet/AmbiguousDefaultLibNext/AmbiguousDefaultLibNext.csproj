<Project Sdk="Microsoft.NET.Sdk">

  <!-- The next version of AmbiguousDefaultLib under the same identity. An
       application compiled against the first version and run against this one
       meets sibling overrides that C# would reject at compile time. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AmbiguousDefaultLib</AssemblyName>
    <RootNamespace>AmbiguousDefaultLib</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../AmbiguousDefaultLib/Shared.cs" Link="Shared.cs" />
  </ItemGroup>

</Project>
