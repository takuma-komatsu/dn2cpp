<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-aliases'">$(DefineConstants);CLONE_CLASS_ALIASES</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-invoke'">$(DefineConstants);CLONE_CLASS_INVOKE</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-null'">$(DefineConstants);CLONE_CLASS_NULL</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-overrides'">$(DefineConstants);CLONE_CLASS_OVERRIDES</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-override-only'">$(DefineConstants);CLONE_CLASS_OVERRIDE_ONLY</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-reflected-generic'">$(DefineConstants);CLONE_CLASS_REFLECTED_GENERIC</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-reflected-type'">$(DefineConstants);CLONE_CLASS_REFLECTED_TYPE</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-reflected-field'">$(DefineConstants);CLONE_CLASS_REFLECTED_FIELD</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-native'">$(DefineConstants);CLONE_CLASS_NATIVE</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-all'">$(DefineConstants);CLONE_CLASS_ALL</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-string'">$(DefineConstants);CLONE_STRING</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-string-calls'">$(DefineConstants);CLONE_STRING_CALLS</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-delegate'">$(DefineConstants);CLONE_DELEGATE</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-group'">$(DefineConstants);CLONE_GROUP</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-ordinary'">$(DefineConstants);CLONE_ORDINARY</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'clone-all'">$(DefineConstants);CLONE_ALL</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'safegroups'">$(DefineConstants);SAFEHANDLE_GROUPS</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'safeinvoke'">$(DefineConstants);SAFEHANDLE_INVOCATION</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'safeordinary'">$(DefineConstants);SAFEHANDLE_ORDINARY</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'safenull'">$(DefineConstants);SAFEHANDLE_NULL</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'safeall'">$(DefineConstants);SAFEHANDLE_ALL</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'safe'">$(DefineConstants);LIFETIME_SAFE</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'wait'">$(DefineConstants);LIFETIME_WAIT</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'event'">$(DefineConstants);LIFETIME_EVENT</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'task'">$(DefineConstants);LIFETIME_TASK</DefineConstants>
    <DefineConstants Condition="'$(LifetimeInterfaceRoute)' == 'direct'">$(DefineConstants);LIFETIME_DIRECT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-completed'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_COMPLETED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-result'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_RESULT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-source'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_SOURCE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-generic-source'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_GENERIC_SOURCE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-async'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_ASYNC</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-cold'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_COLD</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-run'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_RUN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LifetimeInterfaceRoute)' == 'factory-all'">
    <DefineConstants>$(DefineConstants);LIFETIME_FACTORY_ALL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RuntimeHandleRelationSubset.cs" Condition="'$(LifetimeInterfaceRoute)' != 'clone-class-reflected-field'" />
    <Compile Include="DelegateCloneFieldTypeSubset.cs" Condition="'$(LifetimeInterfaceRoute)' == 'clone-class-reflected-field'" />
    <Compile Include="RuntimeLifetimeInterfacesOnlyProgram.cs" />
  </ItemGroup>
</Project>
