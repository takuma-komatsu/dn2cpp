<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TrimReflectLib/TrimReflectLib.csproj" />
    <ProjectReference Include="../../../gates/fixtures/ldftn-local/LdftnLocalFixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <Compile Include="RuntimeTemplateBindingOnlyProgram.cs" />
    <Compile Include="ReflectDelegateSubset.cs" />
    <Compile Include="ReflectInvokeValidationSubset.cs" />
  </ItemGroup>
  <Target Name="RewriteTemplatePointerSlots" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../../../gates/fixtures/ldftn-local/LdftnLocalFixture.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" PropertyName="TemplatePointerFixturePath" />
    </MSBuild>
    <Exec Command="dotnet exec &quot;$(TemplatePointerFixturePath)&quot; &quot;$(TargetPath)&quot; --template-pointer-slots" />
  </Target>
</Project>
