<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);8500</NoWarn>
    <DefineConstants Condition="'$(PointerArrayInvokeOnly)' == 'true'">$(DefineConstants);POINTER_ARRAY_INVOKE_ONLY</DefineConstants>
    <DefineConstants Condition="'$(PointerArrayRoute)' == 'from'">$(DefineConstants);POINTER_ARRAY_FROM_ONLY</DefineConstants>
    <DefineConstants Condition="'$(PointerArrayRoute)' == 'create'">$(DefineConstants);POINTER_ARRAY_CREATE_ONLY</DefineConstants>
    <DefineConstants Condition="'$(PointerArrayRoute)' == 'jagged'">$(DefineConstants);POINTER_ARRAY_JAGGED_ONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ReflectInvokeValidationSubset.cs" />
    <Compile Include="PointerArrayTypesOnlyProgram.cs" />
  </ItemGroup>
</Project>
