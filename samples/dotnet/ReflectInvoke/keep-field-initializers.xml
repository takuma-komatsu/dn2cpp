      <method name=".cctor" />
    </type>
    <type fullname="ReflectFieldValidationSubset.Outer+Nested">
      <method name=".cctor" />
    </type>
    <type fullname="ReflectFieldValidationSubset.Generic`1">
      <method name=".cctor" />
    </type>
    <type fullname="ReflectFieldValidationSubset.PointerReadOnly">
      <method name=".cctor" />
    </type>
    <type fullname="ReflectFieldValidationSubset.AccessedReadOnly">
      <method name=".cctor" />
    </type>
  </assembly>
</linker>
