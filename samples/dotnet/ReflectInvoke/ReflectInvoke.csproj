<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <!-- DateTimeLayoutSubset reads the IL `sizeof` of a non-primitive struct and
         the raw 64-bit image of a DateTime; both need unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Dn2Cpp.Runtime/Dn2Cpp.Runtime.csproj" />
    <ProjectReference Include="../../../gates/fixtures/ldftn-local/LdftnLocalFixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Gives LdftnLocalSubset's stubs the IL bodies C# cannot express. -->
  <Target Name="RewriteLdftnLocalFixture" AfterTargets="Build">
    <Exec Command="dotnet exec &quot;$(MSBuildProjectDirectory)/../../../gates/fixtures/ldftn-local/bin/$(Configuration)/$(TargetFramework)/LdftnLocalFixture.dll&quot; &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
