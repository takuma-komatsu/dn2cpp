<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <!-- DateTimeLayoutSubset reads the IL `sizeof` of a non-primitive struct and
         the raw 64-bit image of a DateTime; both need unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Dn2Cpp.Runtime/Dn2Cpp.Runtime.csproj" />
    <ProjectReference Include="../../../gates/fixtures/ldftn-local/LdftnLocalFixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Gives LdftnLocalSubset's stubs the IL bodies C# cannot express. -->
  <Target Name="RewriteLdftnLocalFixture" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)/../../../gates/fixtures/ldftn-local/LdftnLocalFixture.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" PropertyName="LdftnLocalFixturePath" />
    </MSBuild>
    <Exec Command="dotnet exec &quot;$(LdftnLocalFixturePath)&quot; &quot;$(TargetPath)&quot;" />
  </Target>

  <ItemGroup>
    <Compile Remove="OrdinaryReflectionLeavesProgram.cs" />
    <Compile Remove="ReflectFieldValidationSubset.cs" />
    <Compile Remove="OrdinaryAmbiguousMatchSubset.cs" />
    <Compile Remove="OrdinaryWideLookupSubset.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ReflectionMethodGroupsOnlyProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ReflectBindOnlyProgram.cs" />
    <Compile Remove="ReflectNameBindOnlyProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="StrippedOverrideRefusalsProgram.cs" />
    <Compile Remove="ReflectPointerFieldsOnlyProgram.cs" />
  </ItemGroup>

</Project>
