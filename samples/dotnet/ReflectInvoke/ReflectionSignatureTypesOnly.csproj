<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);SIGNATURE_TYPES_ONLY</DefineConstants>
    <NoWarn>$(NoWarn);8500</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SignatureTypesUnshared)' == 'true'">
    <DefineConstants>$(DefineConstants);SIGNATURE_TYPES_UNSHARED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ReflectionSignatureTypesSubset.cs" />
  </ItemGroup>
</Project>
