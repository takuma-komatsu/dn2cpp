<linker>
  <assembly fullname="Google.Protobuf">
    <!-- Descriptor accessors look these members up by names they compute from the
         descriptor: "Has" or "Clear" plus a field name, oneof name plus "Case". -->
    <type fullname="Google.Protobuf.WellKnownTypes.Value" preserve="nothing">
      <method name="Clear*" />
      <property name="Has*" />
      <property name="KindCase" />
    </type>
    <!-- JsonFormatter reads enum field attributes through runtime FieldInfo. -->
    <type fullname="Google.Protobuf.Reflection.OriginalNameAttribute" preserve="nothing">
      <method signature="System.Void .ctor(System.String)" />
    </type>
  </assembly>
</linker>
