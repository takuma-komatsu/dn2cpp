<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Transpiled gRPC unary client, run against the real .NET oracle server in
    samples/dotnet/GrpcUnaryServer/ (a running Greeter service, not the
    server-less reach probe GrpcProbe is). Requires a NETWORK RESTORE (these
    packages are not vendored). The versions below are exact pins and must match
    GrpcProbe's — do not float them to a range; bump both deliberately.

    The generated protobuf/gRPC code (client stub + server base) is shared
    with GrpcProbe by LINKING its Generated/*.cs rather than copying it, so
    there is exactly one checked-in copy. See
    ../GrpcProbe/Generated/Greet.cs and ../GrpcProbe/Generated/GreetGrpc.cs
    for the regeneration recipe.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../GrpcProbe/Generated/*.cs" LinkBase="Generated" />
  </ItemGroup>

</Project>
