<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Keep IL simple/predictable for the converter fence -->
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time surface for the Godot base image's hook types AND (via
         the transitive GodotSharp shim reference) the engine-shim classes the
         patch calls into; the emit-patch converter resolves both name-based
         into BPI imports bound against the running base at load time. -->
    <ProjectReference Include="../../godot/HotUpdateGodotSample/HotUpdateGodotSample.csproj" />
  </ItemGroup>

</Project>
