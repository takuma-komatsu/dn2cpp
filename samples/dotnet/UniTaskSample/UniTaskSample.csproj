<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The REAL .NET UniTask from nuget.org (Cysharp, MIT) — the acquisition path is
         part of what the gate tests; no DLL is vendored. The DLL's content is pinned
         by gates/expected/unitask-dll.sha256. -->
    <PackageReference Include="UniTask" Version="2.5.11" />
  </ItemGroup>

</Project>
