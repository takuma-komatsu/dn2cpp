[configuration]

entry_symbol = "dn2cpp_gdext_init"
compatibility_minimum = "4.4"

[libraries]

macos.debug = "res://bin/libdn2cpp.dylib"
macos.release = "res://bin/libdn2cpp.dylib"
linux.debug = "res://bin/libdn2cpp.so"
linux.release = "res://bin/libdn2cpp.so"
windows.debug.x86_64 = "res://bin/dn2cpp.dll"
windows.release.x86_64 = "res://bin/dn2cpp.dll"
