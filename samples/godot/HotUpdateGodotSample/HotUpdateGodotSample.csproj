<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Godot API surface comes from the shared "fake GodotSharp" shim,
         exactly like GodotSample; passed to the transpiler via -r. -->
    <ProjectReference Include="../../../src/GodotSharpShim/GodotSharp.csproj" />
    <!-- Compile-time surface for Dn2Cpp.Runtime.HotUpdate; the transpiler maps
         the call to the runtime intrinsic and auto-references its own copy. -->
    <ProjectReference Include="../../../src/Dn2Cpp.Runtime/Dn2Cpp.Runtime.csproj" />
  </ItemGroup>

</Project>
