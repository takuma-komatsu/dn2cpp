<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets-only NuGet package: PackageReference this from an app project and
       `dotnet publish` produces a native binary via the installed dn2cpp tool
       (which carries the C++ runtime; this package ships no payload of its own,
       so the two can never skew on the runtime sources). No lib/ output — the
       package is just build/Dn2Cpp.Build.{props,targets}. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: intentional — a targets-only package has no lib/ per-TFM group. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>Dn2Cpp.Build</PackageId>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/takuma-komatsu/dn2cpp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/takuma-komatsu/dn2cpp.git</RepositoryUrl>
    <Description>MSBuild integration for dn2cpp: PackageReference this and `dotnet publish` transpiles your app to C++ and builds a native binary with the dn2cpp dotnet tool (install it separately: dotnet tool install -g dn2cpp).</Description>
    <PackageTags>transpiler;cpp;aot;il2cpp;native;msbuild</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
