<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dn2Cpp.Godot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Dn2Cpp.Transpiler/Dn2Cpp.Transpiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shim Variant's kind-tag constants, compiled into both the shim
         assembly and this backend so the two can never drift. -->
    <Compile Include="../GodotSharpShim/VariantKind.cs" Link="VariantKind.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI composition root (assembly "dn2cpp") selects this backend. -->
    <InternalsVisibleTo Include="dn2cpp" />
  </ItemGroup>

</Project>
