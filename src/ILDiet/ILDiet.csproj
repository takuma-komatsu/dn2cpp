<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ILDiet</AssemblyName>
    <RootNamespace>Dn2Cpp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ildiet</ToolCommandName>
    <PackageId>ILDiet</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Managed assembly stripping for dn2cpp.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <None Update="Mono.Cecil.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../Dn2Cpp.Transpiler/RawAsyncAdoption.cs" Link="RawAsyncAdoption.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/PreservationReader.cs" Link="PreservationReader.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/EnvKnobs.cs" Link="EnvKnobs.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/StableHash.cs" Link="StableHash.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/ILDietProtocol.cs" Link="ILDietProtocol.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/StrippingLevel.cs" Link="StrippingLevel.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/TypeNameSnapshot.cs" Link="TypeNameSnapshot.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/ILDecoder.cs" Link="ILDecoder.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/ReflectionApis.cs" Link="ReflectionApis.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/ReflectionSummary.cs" Link="ReflectionSummary.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/RawAssemblyTypeResolver.cs" Link="RawAssemblyTypeResolver.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/ScalarNumericLeafContract.cs" Link="ScalarNumericLeafContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/BinaryIntegerEndianContract.cs" Link="BinaryIntegerEndianContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/PrimitiveParseContract.cs" Link="PrimitiveParseContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/DecimalBinaryContract.cs" Link="DecimalBinaryContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/PrimitiveWideConversionContract.cs" Link="PrimitiveWideConversionContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/DelegateCallableBodyContract.cs" Link="DelegateCallableBodyContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/DateTimeManagedBodyContract.cs" Link="DateTimeManagedBodyContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/DateTimeFormatInfoManagedBodyContract.cs" Link="DateTimeFormatInfoManagedBodyContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/RangeThrowManagedBodyContract.cs" Link="RangeThrowManagedBodyContract.cs" />
    <Compile Include="../Dn2Cpp.Transpiler/CoreIntrinsics.TypeMaps.cs" Link="CoreIntrinsics.TypeMaps.cs" />
  </ItemGroup>
  <Target Name="CollectILDietRuntimeLicenses" BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="ResolveRuntimePackAssets" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_ILDietCoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_ILDietRuntimeLicense Include="@(_ILDietCoreRuntimePack->'%(PackageDirectory)/LICENSE.TXT');@(_ILDietCoreRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
      <ResolvedFileToPublish Include="@(_ILDietRuntimeLicense)">
        <RelativePath>runtime-%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
