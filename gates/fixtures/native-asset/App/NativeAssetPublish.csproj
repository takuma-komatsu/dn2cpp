    <RestoreSources>$(NativeAssetFeed)</RestoreSources>
    <NativeAssetFixtureVersion Condition="'$(NativeAssetFixtureVersion)' == ''">1.0.0</NativeAssetFixtureVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dn2Cpp.NativeAssetFixture" Version="$(NativeAssetFixtureVersion)" />
  </ItemGroup>
  <Import Project="../../../../src/Dn2Cpp.Build/build/Dn2Cpp.Build.props" />
  <Import Project="../../../../src/Dn2Cpp.Build/build/Dn2Cpp.Build.targets" />
</Project>
